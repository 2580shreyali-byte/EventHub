# Server Configuration (Port 5001 avoids macOS AirPlay receiver on 5000)
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Local MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_local_mysql_password_here
MYSQL_DATABASE=eventhub

# Authentication & Security
JWT_SECRET=eventhub_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=86400
